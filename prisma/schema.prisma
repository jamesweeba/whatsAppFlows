// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Vendor lifecycle (see VENDOR_ONBOARDING.md). Only ACTIVE shops can message buyers.
enum TenantStatus {
  /// Signed up, no in-stock product yet.
  PENDING
  /// Has at least one in-stock product; waiting in the review queue.
  STOCKED
  /// A super admin has started reviewing it.
  UNDER_REVIEW
  /// Reviewer asked for changes; the vendor resubmits to go back to STOCKED.
  MORE_INFO
  /// Not approved; the vendor can fix things and resubmit.
  REJECTED
  /// Approved and assigned a WhatsApp number.
  ACTIVE
  /// Closed by a super admin; read-only.
  SUSPENDED
}

enum UserRole {
  VENDOR
  SUPER_ADMIN
}

/// Every admin action, for the audit log.
enum AuditAction {
  REVIEW_STARTED
  CHECKLIST_UPDATED
  APPROVED
  MORE_INFO_REQUESTED
  REJECTED
  SUSPENDED
  NUMBER_RELEASED
  REINSTATED
  NUMBER_ADDED
  NUMBER_FREED
  NUMBER_REFRESHED
  DOCUMENT_VIEWED
  NOTE_ADDED
  NOTE_EDITED
  NOTE_DELETED
  BANNER_APPROVED
  BANNER_REJECTED
  BANNER_REMOVED
  PAYOUT_RETRIED
  PAYOUT_SENT
  PAYOUTS_PAUSED
  PAYOUTS_RESUMED
  ORDER_RELEASED
  PROMOTER_SUSPENDED
  PROMOTER_REINSTATED
  PROMOTER_PAYOUT_RETRIED
  VIDEO_APPROVED
  VIDEO_REJECTED
  VIDEO_REMOVED
}

/// A pool number's state. COOLING numbers count as FREE once released over 7 days ago.
enum NumberStatus {
  FREE
  ASSIGNED
  COOLING
}

enum ReviewDecision {
  APPROVED
  MORE_INFO
  REJECTED
  SUSPENDED
  RELEASED
  REINSTATED
}

enum DocumentType {
  GHANA_CARD_FRONT
  GHANA_CARD_BACK
  STALL_PHOTO
  BUSINESS_REG
}

enum WabaStatus {
  PENDING_REGISTRATION
  OTP_SENT
  VERIFIED
  FAILED
}

enum MessageSender {
  BUYER
  VENDOR
  SYSTEM
}

enum MessageSource {
  TEXT
  FLOW_SELECTION
  MEDIA
  LOCATION
}

enum BuyerIntent {
  GREETING
  VIEW_CATALOG
  PRODUCT_INQUIRY
  STOCK_CHECK
  ORDER_INTENT
  HUMAN_SUPPORT
  OUT_OF_BOUNDS
}

enum PaymentMethod {
  MOMO
  CARD
  COD
}

enum Fulfillment {
  DELIVERY
  PICKUP
}

enum OrderStatus {
  PENDING
  AWAITING_PAYMENT
  PAID
  CONFIRMED
  PROCESSING
  OUT_FOR_DELIVERY
  DELIVERED
  COMPLETED
  CANCELLED
  REFUNDED
}

model Tenant {
  id                    String              @id @default(uuid())
  /// Sequential vendor number, shown to admins as MX-V-0001.
  refNumber             Int                 @unique @default(autoincrement())
  name                  String
  slug                  String              @unique
  /// The buyer-facing number. Set on approval from the pool (or by own-number OTP onboarding).
  whatsappNumber        String?             @unique
  countryCode           String              @default("233")
  /// Meta's id for whatsappNumber; routes webhooks and sends replies. Kept in sync with the
  /// assigned WhatsappNumber row on approve and release.
  whatsappPhoneNumberId String?             @unique
  wabaStatus            WabaStatus          @default(PENDING_REGISTRATION)
  wabaRegisteredAt      DateTime?
  description           String?
  deliveryFee           Float               @default(5)
  pickupNote            String?
  /// Delivery areas offered on the Flow CHECKOUT screen: [{ id, title }].
  deliveryAreas         Json?
  /// Delivery slots offered on the Flow CHECKOUT screen: [{ id, title, description? }]. Always includes "asap".
  deliverySlots         Json?
  status                TenantStatus        @default(PENDING)
  /// When the shop last entered STOCKED; the review queue is ordered by it.
  submittedAt           DateTime?
  /// Shop owner details for KYC. Nullable only for shops created before onboarding existed.
  ownerFullName         String?
  /// The vendor's own phone: welcome, review and order alerts go here.
  ownerPhone            String?
  market                String?
  stallLocation         String?
  /// MoMo payout number and the name it is registered to (checked during review).
  momoNumber            String?
  momoName              String?
  /// Approved banner shown to buyers on the order form (file in storage). Null: no banner.
  bannerUpdatedAt       DateTime?
  /// A banner the vendor uploaded that an admin has not approved yet.
  bannerPendingAt       DateTime?
  /// Why an admin turned down the last uploaded banner (shown to the vendor until they upload again).
  bannerRejectedReason  String?
  /// Admins can stop withdrawals from this shop (e.g. during a dispute); money keeps accruing.
  payoutsPaused         Boolean             @default(false)
  payoutsPausedReason   String?
  /// Paystack transfer recipient for momoNumber, created on the first payout.
  paystackRecipientCode String?
  /// The MoMo number the recipient above was made for (a new number needs a new recipient).
  paystackRecipientFor  String?
  /// The reviewer's due-diligence ticks while UNDER_REVIEW; cleared on each decision.
  reviewChecks          Json?
  /// Promoters: approved promoters can share this shop's links (see PROMOTERS_SPEC.md).
  promotionsEnabled     Boolean             @default(false)
  /// Listed under SHOPS on the promoter bot so new promoters can ask to join; invites work either way.
  acceptPromoterRequests Boolean            @default(true)
  /// Promoter commission on items, whole percent (1-20). Required before promotions can be enabled.
  promoterRate          Int?
  promoterMemberships   PromoterMembership[]
  promoLinks            PromoLink[]
  referrals             Referral[]
  documents             VendorDocument[]
  reviews               VendorReview[]
  notes                 VendorNote[]
  ledger                VendorLedgerEntry[]
  payouts               VendorPayout[]
  number                WhatsappNumber?
  userId                String              @unique
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  products              Product[]
  chatSessions          ChatSession[]
  orders                Order[]
  flowCarts             FlowCart[]
  createdAt             DateTime            @default(now())
  modifiedAt            DateTime            @updatedAt
}

model ChatSession {
  id             String        @id @default(uuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  buyerPhone     String
  lastIntent     BuyerIntent?
  orderCompleted Boolean       @default(false)
  messages       ChatMessage[]
  orders         Order[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([tenantId, buyerPhone])
  @@index([tenantId, buyerPhone, orderCompleted])
}

model ChatMessage {
  id                String        @id @default(uuid())
  sessionId         String
  session           ChatSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sender            MessageSender
  source            MessageSource @default(TEXT)
  whatsappMessageId String?       @unique
  text              String
  flowData          Json?
  detectedIntent    BuyerIntent?
  confidenceScore   Float?
  rawAiResponse     Json?
  createdAt         DateTime      @default(now())
}

/// Platform-wide product categories. Vendors pick one per product; the list is seeded by migration.
model Category {
  /// Stable, readable id used by the API and the Flow, e.g. "veg_fruits".
  id          String    @id
  title       String
  description String?
  sortOrder   Int       @default(0)
  products    Product[]
  createdAt   DateTime  @default(now())
  modifiedAt  DateTime  @updatedAt
}

model Product {
  id             String           @id @default(uuid())
  name           String
  /// An emoji shown before the name in WhatsApp text lists (e.g. "🍅"), not a photo.
  image          String?
  /// Set when the vendor uploaded a photo. The file is stored at products/<tenantId>/<id>
  /// and served publicly at GET /products/:id/photo.
  photoMimeType  String?
  photoUpdatedAt DateTime?
  /// Base price; the cheapest measure's price when measures exist.
  price          Float
  inStock        Boolean          @default(true)
  /// Short line shown under the product name in the Flow, e.g. "Olonka ≈ 2 kg".
  note           String?
  /// Required by the API; nullable only so products created before categories existed stay valid.
  categoryId     String?
  category       Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  measures       ProductMeasure[]
  /// Promoter commission for this product's links, whole percent (1-20). Null: the shop's rate.
  promoterRate   Int?
  /// Videos of the whole product and of its measures (see VIDEO_SPEC.md).
  videos         ProductVideo[]
  promoLinks     PromoLink[]
  tenantId       String
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderItems     OrderItem[]
  createdAt      DateTime         @default(now())
  modifiedAt     DateTime         @updatedAt
}

/// A way a product is sold (olonka, basket, table top...), each with its own price.
model ProductMeasure {
  id          String  @id @default(uuid())
  productId   String
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  code        String
  label       String
  description String?
  price       Float
  sortOrder   Int     @default(0)

  @@unique([productId, code])
}

/// Server-side basket for one WhatsApp Flow session, keyed by flow_token.
model FlowCart {
  id         String   @id @default(uuid())
  flowToken  String   @unique
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  buyerPhone String
  /// [{ sku, measure, qty }] in the order they were added.
  lines      Json     @default("[]")
  /// The line being edited on PRODUCT: { sku, measure, fromBasket }.
  editing    Json?
  order      Order?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([updatedAt])
}

model User {
  id          String         @id @default(uuid())
  email       String         @unique
  password    String
  firstName   String
  lastName    String
  /// SUPER_ADMIN accounts are created by `npm run admin:create`, never by signup.
  role        UserRole       @default(VENDOR)
  tenant      Tenant?
  reviews     VendorReview[]
  vendorNotes VendorNote[]
  createdAt   DateTime       @default(now())
  modifiedAt  DateTime       @updatedAt
}

/// A KYC file the vendor uploaded. One per type; uploading again replaces it.
model VendorDocument {
  id         String       @id @default(uuid())
  tenantId   String
  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type       DocumentType
  /// Where StorageService keeps the file, e.g. "kyc/<tenantId>/<uuid>.jpg". Never a public URL.
  storageKey String
  fileName   String
  mimeType   String
  size       Int
  uploadedAt DateTime     @default(now())

  @@unique([tenantId, type])
}

/// Audit trail: one row per super admin decision on a shop.
model VendorReview {
  id         String         @id @default(uuid())
  tenantId   String
  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reviewerId String
  reviewer   User           @relation(fields: [reviewerId], references: [id])
  decision   ReviewDecision
  /// { ghanaCardMatches, momoNameMatches, calledOwner, productsLookGenuine } as ticked.
  checks     Json?
  /// Shown to the vendor on MORE_INFO and REJECTED.
  notes      String?
  /// The pool number involved in an APPROVED or RELEASED decision.
  numberId   String?
  createdAt  DateTime       @default(now())

  @@index([tenantId, createdAt])
}

/// An admin's private note on a shop (calls, promises, follow-ups). Never shown to the vendor.
model VendorNote {
  id        String    @id @default(uuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  authorId  String
  author    User      @relation(fields: [authorId], references: [id])
  body      String
  /// Set when the author edits the note.
  editedAt  DateTime?
  createdAt DateTime  @default(now())

  @@index([tenantId, createdAt])
}

/// A WhatsApp number registered under the MarketiX WABA, assigned to at most one shop.
model WhatsappNumber {
  id             String       @id @default(uuid())
  /// Meta's phone number id.
  phoneNumberId  String       @unique
  displayNumber  String       @unique
  /// Null only for numbers carried over from shops that onboarded before the pool existed.
  wabaId         String?
  status         NumberStatus @default(FREE)
  tenantId       String?      @unique
  tenant         Tenant?      @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  /// WhatsApp display name for the shop; recorded on approve (submission to Meta is manual for now).
  displayName    String?
  /// From Meta on refresh: GREEN, YELLOW, RED or UNKNOWN.
  qualityRating  String?
  /// From Meta on refresh, e.g. TIER_1K.
  messagingLimit String?
  refreshedAt    DateTime?
  assignedAt     DateTime?
  releasedAt     DateTime?
  createdAt      DateTime     @default(now())
  modifiedAt     DateTime     @updatedAt

  @@index([status])
}

model Order {
  id                  String              @id @default(uuid())
  orderNumber         String              @unique @default(uuid())
  tenantId            String
  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  buyerPhone          String
  sessionId           String?
  session             ChatSession?        @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  status              OrderStatus         @default(PENDING)
  totalAmount         Float
  paymentMethod       PaymentMethod?
  paymentPhone        String?
  momoNetwork         String?
  fulfillment         Fulfillment?
  deliveryAddress     String?
  deliveryFee         Float               @default(0)
  customerName        String?
  deliveryArea        String?
  landmark            String?
  contactPhone        String?
  deliverySlot        String?
  /// Set once the MoMo prompt is sent, so it is never sent twice.
  paymentRequestedAt  DateTime?
  /// Set once the receipt, MoMo prompt and pin request went out for a Flow order (on place_order or Done).
  confirmationSentAt  DateTime?
  locationRequestedAt DateTime?
  locationLatitude    Float?
  locationLongitude   Float?
  locationName        String?
  locationAddress     String?
  locationReceivedAt  DateTime?
  /// When the buyer tapped "I got my order" on the out-for-delivery message (moves it to DELIVERED).
  deliveryConfirmedAt DateTime?
  /// Set when Paystack confirmed the buyer's payment (the money is in MarketiX's Paystack balance).
  paystackPaidAt      DateTime?
  /// What Paystack reported collecting, in pesewas.
  paystackAmount      Int?
  /// How the buyer paid on Paystack ("mobile_money", "card", ...). Card earnings are held before they can be withdrawn.
  paystackChannel     String?
  /// When the buyer was sent the "rate your order" list after confirming delivery (sent once).
  ratingRequestedAt   DateTime?
  /// The buyer's 1-5 rating of the order, from WhatsApp.
  buyerRating         Int?
  ratedAt             DateTime?
  riderName           String?
  riderPhone          String?
  /// Entered by the vendor in the dashboard, not placed by the buyer. Doesn't count as the
  /// buyer's first order for promoter commission unless Paystack took payment for it.
  vendorCreated       Boolean             @default(false)
  flowCartId          String?             @unique
  flowCart            FlowCart?           @relation(fields: [flowCartId], references: [id], onDelete: SetNull)
  notes               String?
  items               OrderItem[]
  ledger              VendorLedgerEntry[]
  /// The promoter's link that brought this buyer, when this is their first order with the shop.
  referral            Referral?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([tenantId, ratedAt])
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String
  measureCode String?
  unitPrice   Float
  quantity    Int
  totalPrice  Float
  createdAt   DateTime @default(now())
}

/// Append-only record of admin actions. A database trigger refuses UPDATE and DELETE.
/// No foreign keys on purpose: names are copied in, so an entry outlives the shop, number
/// or admin it mentions.
model AuditLog {
  id            String      @id @default(uuid())
  actorId       String
  actorName     String
  action        AuditAction
  tenantId      String?
  tenantName    String?
  numberId      String?
  displayNumber String?
  /// Human-readable, e.g. "Assigned +233 59 200 1128." or the reviewer's notes.
  details       String?
  /// Structured extras: checks ticked, document type, Meta quality before and after.
  metadata      Json?
  createdAt     DateTime    @default(now())

  @@index([createdAt])
  @@index([tenantId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

enum LedgerEntryType {
  /// Vendor's share of a paid (MoMo or card) order once the buyer confirmed delivery: items less commission, plus delivery fee.
  ORDER_EARNING
  /// MarketiX's commission on a cash-on-delivery order, owed by the vendor (negative).
  CASH_COMMISSION
  /// Money sent to the vendor's MoMo (negative).
  PAYOUT
  /// A payout that failed or was reversed, credited back (positive).
  PAYOUT_REVERSAL
  /// A promoter's commission on a paid order they brought in, taken off the vendor's earning (negative).
  PROMOTER_COMMISSION
}

/// Money MarketiX owes each vendor, in pesewas: positive entries are owed to the vendor,
/// negative ones were paid out or are owed by the vendor. The balance is the sum.
/// Rows are never edited or deleted; corrections are new rows.
model VendorLedgerEntry {
  id          String          @id @default(uuid())
  tenantId    String
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type        LedgerEntryType
  amount      Int
  /// The order this entry is for (null once the order is deleted; orderNumber keeps the reference).
  orderId     String?
  order       Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderNumber String?
  payoutId    String?
  payout      VendorPayout?   @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  /// For orders: { items, commission, deliveryFee } in pesewas, so statements can show the sums.
  details     Json?
  /// When the vendor can withdraw this entry (card earnings are held for a few days in case
  /// the payment is disputed). Null: right away.
  availableAt DateTime?
  createdAt   DateTime        @default(now())

  /// An order earns, or owes commission, once.
  @@unique([orderId, type])
  @@index([tenantId, createdAt])
}

enum PayoutStatus {
  /// Created; the transfer request is being sent to Paystack.
  PENDING
  /// Paystack accepted the transfer; waiting for its success or failure webhook.
  PROCESSING
  SUCCESS
  /// Failed or reversed; the amount is back in the vendor's balance. Admins can retry.
  FAILED
}

/// Who started a payout.
enum PayoutSource {
  /// The vendor withdrew from their balance (once per Accra day).
  VENDOR
  /// An admin's "Pay now" or "Retry".
  ADMIN
  /// The old 7:00 am daily run (before withdrawals replaced it).
  AUTOMATIC
}

/// One Paystack transfer from a vendor's balance to their MoMo wallet.
model VendorPayout {
  id            String              @id @default(uuid())
  tenantId      String
  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Pesewas.
  amount        Int
  status        PayoutStatus        @default(PENDING)
  /// Our transfer reference, sent to Paystack and echoed in its webhooks.
  reference     String              @unique
  transferCode  String?
  momoNumber    String
  momoName      String?
  source        PayoutSource        @default(ADMIN)
  /// The vendor's user (withdrawals) or the admin who sent or retried it; null for automatic payouts.
  initiatedById String?
  failureReason String?
  paidAt        DateTime?
  entries       VendorLedgerEntry[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([tenantId, createdAt])
  @@index([status, createdAt])
  @@index([tenantId, source, createdAt])
}

// ───────────────────────── Promoters ─────────────────────────
// People who share shops' links on WhatsApp and earn a commission on new buyers' orders.
// They use the platform number's bot; there is no promoter login. See PROMOTERS_SPEC.md.

enum PromoterStatus {
  /// Going through the sign-up chat (see signupStep).
  SIGNING_UP
  ACTIVE
  /// Stopped by an admin: links stop counting and withdrawals are blocked.
  SUSPENDED
}

/// Where a promoter is in the sign-up chat.
enum PromoterSignupStep {
  ASK_NAME
  ASK_MOMO
  CONFIRM_MOMO_NAME
  ASK_TERMS
}

enum PromoterMembershipStatus {
  /// The promoter asked to promote the shop; waiting for the vendor.
  REQUESTED
  /// The vendor invited a phone number; waiting for that person to send JOIN <code>.
  INVITED
  APPROVED
  DECLINED
  /// The vendor removed an approved promoter. Their links are deactivated.
  REMOVED
}

/// One per WhatsApp number. A vendor can be a promoter with the same number.
model Promoter {
  id                    String                  @id @default(uuid())
  /// E.164, e.g. +233244111222. Their identity: the bot knows them by it.
  phone                 String                  @unique
  fullName              String?
  /// Ghana local, e.g. 0244111222.
  momoNumber            String?
  /// Paystack mobile-money bank code: MTN, VOD or ATL.
  momoNetwork           String?
  /// The name Paystack says the MoMo number is registered to. Null if Paystack could not tell us.
  momoName              String?
  /// Set when momoName came from Paystack (not just what the promoter typed).
  momoVerifiedAt        DateTime?
  termsAcceptedAt       DateTime?
  status                PromoterStatus          @default(SIGNING_UP)
  /// Why an admin suspended them (shown to admins). Cleared on reinstatement.
  suspendedReason       String?
  signupStep            PromoterSignupStep?     @default(ASK_NAME)
  /// An invite they started sign-up from (JOIN <code>), accepted once sign-up finishes.
  pendingInviteCode     String?
  /// The last inbound WhatsApp message handled, so a webhook Meta retries is not handled twice.
  lastInboundMessageId  String?
  /// Paystack transfer recipient for momoNumber, made on the first withdrawal.
  paystackRecipientCode String?
  /// The MoMo number the recipient above was made for.
  paystackRecipientFor  String?
  ledger                PromoterLedgerEntry[]
  payouts               PromoterPayout[]
  memberships           PromoterMembership[]
  links                 PromoLink[]
  referrals             Referral[]
  createdAt             DateTime                @default(now())
  modifiedAt            DateTime                @updatedAt
}

/// A promoter's relationship with one shop: requested, invited, approved...
model PromoterMembership {
  id               String                   @id @default(uuid())
  tenantId         String
  tenant           Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Null while an invite has not been accepted.
  promoterId       String?
  promoter         Promoter?                @relation(fields: [promoterId], references: [id], onDelete: Cascade)
  status           PromoterMembershipStatus
  /// Invites: the number the vendor invited (E.164); only that number can accept.
  invitedPhone     String?
  /// Invites: the code in the join link (JOIN <code>). Cleared once accepted or cancelled.
  inviteCode       String?                  @unique
  /// Invites: products the vendor chose. Empty: the whole shop.
  inviteProductIds String[]                 @default([])
  requestedAt      DateTime                 @default(now())
  decidedAt        DateTime?
  removedAt        DateTime?
  links            PromoLink[]
  createdAt        DateTime                 @default(now())
  modifiedAt       DateTime                 @updatedAt

  @@unique([tenantId, promoterId])
  @@index([tenantId, status])
}

/// One shareable link: the whole shop (productId null) or one product. Buyers' first
/// message carries "(ref <code>)". At most one active link per membership and product,
/// enforced by partial unique indexes in the migration.
model PromoLink {
  id           String             @id @default(uuid())
  /// 6 characters without look-alikes, e.g. K7Q2MX.
  code         String             @unique
  membershipId String
  membership   PromoterMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  tenantId     String
  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  promoterId   String
  promoter     Promoter           @relation(fields: [promoterId], references: [id], onDelete: Cascade)
  productId    String?
  product      Product?           @relation(fields: [productId], references: [id], onDelete: Cascade)
  active       Boolean            @default(true)
  referrals    Referral[]
  createdAt    DateTime           @default(now())
  modifiedAt   DateTime           @updatedAt

  @@index([promoterId, active])
}

/// A buyer tapped a promoter's link: their first message to the shop carried "(ref <code>)".
/// Their first order with the shop within 14 days is credited to the promoter. The link's
/// code, product and rate are copied in, so the record outlives a deleted link or product.
model Referral {
  id               String    @id @default(uuid())
  tenantId         String
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// E.164, as on Order.buyerPhone.
  buyerPhone       String
  promoterId       String
  promoter         Promoter  @relation(fields: [promoterId], references: [id], onDelete: Cascade)
  linkId           String?
  link             PromoLink? @relation(fields: [linkId], references: [id], onDelete: SetNull)
  linkCode         String
  /// Null: a whole-shop link.
  productId        String?
  productName      String?
  /// Commission percent, locked when the buyer tapped the link.
  ratePercent      Int
  tappedAt         DateTime
  expiresAt        DateTime
  /// The order it was credited to. Moves to a later order if this one is cancelled or never paid.
  orderId          String?   @unique
  order            Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  attachedAt       DateTime?
  /// Pesewas, worked out when the order was attached: what the commission is on, and the commission.
  baseAmount       Int?
  commissionAmount Int?
  createdAt        DateTime  @default(now())
  modifiedAt       DateTime  @updatedAt

  @@index([tenantId, buyerPhone, tappedAt])
  @@index([promoterId, tappedAt])
}

enum PromoterLedgerEntryType {
  /// Commission on an order the promoter brought in (positive), withdrawable from availableAt.
  COMMISSION
  /// Money sent to the promoter's MoMo (negative).
  PAYOUT
  /// A payout that failed or was reversed, credited back (positive).
  PAYOUT_REVERSAL
}

/// Money MarketiX owes each promoter, in pesewas, like VendorLedgerEntry: the balance is the
/// sum. Rows are never edited or deleted. Order and shop are copied in, not linked, so the
/// record outlives them.
model PromoterLedgerEntry {
  id          String                  @id @default(uuid())
  promoterId  String
  promoter    Promoter                @relation(fields: [promoterId], references: [id], onDelete: Restrict)
  type        PromoterLedgerEntryType
  amount      Int
  orderId     String?
  orderNumber String?
  tenantId    String?
  shopName    String?
  payoutId    String?
  payout      PromoterPayout?         @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  /// When the promoter can withdraw it. Null: right away.
  availableAt DateTime?
  createdAt   DateTime                @default(now())

  /// An order pays its promoter once.
  @@unique([orderId, type])
  @@index([promoterId, createdAt])
}

/// One Paystack transfer from a promoter's balance to their MoMo, like VendorPayout.
model PromoterPayout {
  id            String                @id @default(uuid())
  promoterId    String
  promoter      Promoter              @relation(fields: [promoterId], references: [id], onDelete: Restrict)
  /// Pesewas.
  amount        Int
  status        PayoutStatus          @default(PENDING)
  /// Our transfer reference ("ppayout_..."), sent to Paystack and echoed in its webhooks.
  reference     String                @unique
  transferCode  String?
  momoNumber    String
  momoName      String?
  failureReason String?
  paidAt        DateTime?
  /// The admin who sent it (a retry). Null: the promoter withdrew it themselves.
  initiatedById String?
  entries       PromoterLedgerEntry[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([promoterId, createdAt])
  @@index([status, createdAt])
}

/// A short video of a product, or of one of its measures (e.g. the olonka, the table top).
/// The latest upload (converted, then approved by an admin) and the live, approved video are
/// tracked side by side: buyers keep the live one while a new upload waits.
model ProductVideo {
  id                String             @id @default(uuid())
  productId         String
  product           Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// '' for the whole product; otherwise a ProductMeasure code (codes survive product edits).
  measureCode       String             @default("")
  /// The latest upload: being converted, waiting for an admin, turned down...
  status            ProductVideoStatus @default(NONE)
  /// When the pending upload arrived; also tells a finished conversion it is still the latest upload.
  uploadedAt        DateTime?
  pendingSeconds    Int?
  /// The upload was cut to the 30-second limit.
  pendingTrimmed    Boolean            @default(false)
  /// Shown to the vendor: why an admin turned the upload down, or why converting it failed.
  message           String?
  /// When an admin approved the live video. Null: no video for buyers.
  approvedAt        DateTime?
  liveSeconds       Int?
  /// Meta's copy of the live video for the shop's number, reused for 25 days.
  waMediaId         String?
  waMediaUploadedAt DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([productId, measureCode])
  @@index([status])
}

/// Where a video's latest upload stands. The live (approved) video is tracked separately.
enum ProductVideoStatus {
  /// No upload waiting.
  NONE
  /// Uploaded; being converted to MP4.
  PROCESSING
  /// Converted; waiting for an admin.
  PENDING
  /// An admin turned it down (videoMessage says why).
  REJECTED
  /// It couldn't be converted (videoMessage says why).
  FAILED
}
