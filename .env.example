# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema
#
# The app loads this file via dotenv at startup (src/main.ts), so every value below
# is visible to the running server as well as to the Prisma CLI.

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/mydb?schema=public"

# JWT Secret (required, no fallback). Generate with: openssl rand -hex 32
JWT_SECRET="your_jwt_secret_here"

# Meta WhatsApp Business API Configuration
META_BASE_URL="https://graph.facebook.com"
META_API_VERSION="v25.0"
META_WABA_ID="your_waba_id_here"
META_SYSTEM_USER_TOKEN="your_meta_system_user_token_here"
META_DEFAULT_2FA_PIN="123456"
META_WEBHOOK_VERIFY_TOKEN="your_webhook_verify_token_here"
# Meta App Secret (App Dashboard -> Settings -> Basic). Required: used to verify the
# X-Hub-Signature-256 header on POST /api/v1/webhook and the Flow data-exchange endpoint.
META_APP_SECRET="882c8a5c4fb35ab978b31fmu9138b01854c0ce"

# Shared secret for the POST /api/v1/chat endpoint (x-webhook-secret header)
# Generate a strong random string: openssl rand -hex 32
WEBHOOK_SECRET="your_strong_random_secret_here"

# OpenRouter AI Intent Classifier Configuration
AI_API_URL="https://openrouter.ai/api/v1/chat/completions"
AI_API_KEY="your_openrouter_api_key_here"
AI_MODEL="meta-llama/llama-3.3-70b-instruct"

# Meta WhatsApp Flows RSA Data Exchange Encryption Configuration
META_FLOW_ID="1226428740556570"
# Flow mode: 'draft' for development/testing, 'published' for live Meta apps
META_FLOW_MODE="draft"
# The Flow JSON to upload to Meta is src/flow/flow.json. It opens on WELCOME via a data_exchange INIT.
META_FLOW_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_RSA_2048_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----"
META_FLOW_PASSPHRASE=""

# Paystack Payment Gateway Configuration (secret key, sk_test_... or sk_live_...)
# Required for mobile money / card payments and for webhook signature verification.
PAYSTACK_SECRET_KEY="sk_test_your_key_here"

# ── Vendor onboarding ──
# Platform's own WhatsApp number (Meta phone number id) that sends vendors their welcome / review messages.
PLATFORM_PHONE_NUMBER_ID=""
# "true" re-enables vendors registering their own number via OTP (/api/v1/waba/*). Default: pool numbers only.
ALLOW_OWN_NUMBER_ONBOARDING="false"
# Where KYC documents are stored on disk (never served publicly).
UPLOAD_DIR="uploads"
# Web app origins allowed to call the API (comma-separated). Unset: only localhost / 127.0.0.1.
CORS_ORIGINS=""

# Behind a reverse proxy (Traefik, nginx): the number of proxies in front of the API, usually 1.
# Without it every request seems to come from the proxy, and failed logins from anyone lock
# everyone out.
TRUST_PROXY=1
