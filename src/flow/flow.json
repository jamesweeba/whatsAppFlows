        },
        "pickup_note": {
          "type": "string",
          "__example__": "Pick up at Marketix Store, Osu. Ready in about 30 minutes."
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "confirm_form",
            "init-values": {
              "fulfillment": "${data.fulfillment_prefill}"
            },
            "children": [
              {
                "type": "TextHeading",
                "text": "🧾 Review your order"
              },
              {
                "type": "TextBody",
                "text": "${data.summary_lines}"
              },
              {
                "type": "TextSubheading",
                "text": "${data.order_total}"
              },
              {
                "type": "TextBody",
                "text": "${data.error_message}",
                "visible": "${data.show_error}"
              },
              {
                "type": "RadioButtonsGroup",
                "label": "🚚 Get it by",
                "name": "fulfillment",
                "required": true,
                "data-source": [
                  {
                    "id": "delivery",
                    "title": "🛵 Delivery"
                  },
                  {
                    "id": "pickup",
                    "title": "🏪 Pickup"
                  }
                ]
              },
              {
                "type": "If",
                "condition": "${form.fulfillment} == 'delivery'",
                "then": [
                  {
                    "type": "TextArea",
                    "label": "Delivery address",
                    "name": "address",
                    "required": true,
                    "helper-text": "Add a landmark so the rider finds you."
                  }
                ]
              },
              {
                "type": "If",
                "condition": "${form.fulfillment} == 'pickup'",
                "then": [
                  {
                    "type": "TextCaption",
                    "text": "${data.pickup_note}"
                  }
                ]
              },
              {
                "type": "TextCaption",
                "text": "Need to change something? Tap back."
              },
              {
                "type": "Footer",
                "label": "Continue to payment ➜",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "step": "to_payment",
                    "cart": "${data.cart_json}",
                    "fulfillment": "${form.fulfillment}",
                    "address": "${form.address}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "PAYMENT",
      "title": "4 of 4 · Payment",
      "data": {
        "order_total": {
          "type": "string",
          "__example__": "Total: ₵7.00"
        },
        "pay_label": {
          "type": "string",
          "__example__": "Pay ₵7.00"
        },
        "networks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "mtn",
              "title": "MTN MoMo"
            },
            {
              "id": "telecel",
              "title": "Telecel Cash"
            },
            {
              "id": "airteltigo",
              "title": "AirtelTigo Money"
            }
          ]
        },
        "error_message": {
          "type": "string",
          "__example__": " "
        },
        "show_error": {
          "type": "boolean",
          "__example__": false
        },
        "network_prefill": {
          "type": "string",
          "__example__": "mtn"
        },
        "number_prefill": {
          "type": "string",
          "__example__": "0241234567"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "pay_form",
            "init-values": {
              "payment_method": "momo",
              "momo_network": "${data.network_prefill}",
              "momo_number": "${data.number_prefill}"
            },
            "children": [
              {
                "type": "TextHeading",
                "text": "💳 Pay for your order"
              },
              {
                "type": "TextSubheading",
                "text": "${data.order_total}"
              },
              {
                "type": "TextBody",
                "text": "${data.error_message}",
                "visible": "${data.show_error}"
              },
              {
                "type": "RadioButtonsGroup",
                "label": "Payment method",
                "name": "payment_method",
                "required": true,
                "data-source": [
                  {
                    "id": "momo",
                    "title": "📱 Mobile money"
                  },
                  {
                    "id": "card",
                    "title": "💳 Card"
                  },
                  {
                    "id": "cod",
                    "title": "💵 Pay on delivery or pickup"
                  }
                ]
              },
              {
                "type": "If",
                "condition": "${form.payment_method} == 'momo'",
                "then": [
                  {
                    "type": "Dropdown",
                    "label": "Network",
                    "name": "momo_network",
                    "required": true,
                    "data-source": "${data.networks}"
                  },
                  {
                    "type": "TextInput",
                    "label": "Mobile money number",
                    "name": "momo_number",
                    "input-type": "phone",
                    "required": true,
                    "helper-text": "You'll get a prompt on this number. Enter your PIN to approve."
                  }
                ]
              },
              {
                "type": "If",
                "condition": "${form.payment_method} == 'card'",
                "then": [
                  {
                    "type": "TextCaption",
                    "text": "We'll send a secure payment link on WhatsApp after you place the order."
                  }
                ]
              },
              {
                "type": "If",
                "condition": "${form.payment_method} == 'cod'",
                "then": [
                  {
                    "type": "TextCaption",
                    "text": "Pay the rider or the store when you receive your order."
                  }
                ]
              },
              {
                "type": "Footer",
                "label": "${data.pay_label}",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "step": "pay",
                    "payment_method": "${form.payment_method}",
                    "momo_network": "${form.momo_network}",
                    "momo_number": "${form.momo_number}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "DONE",
      "title": "All done",
      "terminal": true,
      "success": true,
      "data": {
        "order_ref": {
          "type": "string",
          "__example__": "MX-1042"
        },
        "done_message": {
          "type": "string",
          "__example__": "Order placed. Approve the payment prompt on your phone. We'll message you on WhatsApp with updates."
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "🎉 Order placed"
          },
          {
            "type": "TextBody",
            "text": "${data.done_message}"
          },
          {
            "type": "TextCaption",
            "text": "Order ref: ${data.order_ref}"
          },
          {
            "type": "Footer",
            "label": "Done",
            "on-click-action": {
              "name": "complete",
              "payload": {
                "order_ref": "${data.order_ref}"
              }
            }
          }
        ]
      }
    }
  ]
}
