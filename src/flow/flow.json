    {
      "id": "PRODUCT",
      "title": "Product",
      "data": {
        "category": {
          "type": "string",
          "__example__": "veg_fruits"
        },
        "page": {
          "type": "string",
          "__example__": "1"
        },
        "sku": {
          "type": "string",
          "__example__": "sku_tomatoes"
        },
        "name": {
          "type": "string",
          "__example__": "Tomatoes"
        },
        "photo": {
          "type": "string",
          "__example__": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg=="
        },
        "note": {
          "type": "string",
          "__example__": "Fresh from Kejetia this morning. Olonka ≈ 2 kg, basket ≈ 12 kg."
        },
        "measures": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "olonka",
              "title": "Olonka · GH₵ 25"
            },
            {
              "id": "basket",
              "title": "Basket · GH₵ 120",
              "description": "Best value"
            },
            {
              "id": "tabletop",
              "title": "Table top · GH₵ 10"
            },
            {
              "id": "remove",
              "title": "Remove from basket"
            }
          ]
        },
        "qty_options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "1",
              "title": "1"
            },
            {
              "id": "2",
              "title": "2"
            },
            {
              "id": "3",
              "title": "3"
            },
            {
              "id": "4",
              "title": "4"
            },
            {
              "id": "5",
              "title": "5"
            },
            {
              "id": "6",
              "title": "6"
            },
            {
              "id": "7",
              "title": "7"
            },
            {
              "id": "8",
              "title": "8"
            },
            {
              "id": "9",
              "title": "9"
            },
            {
              "id": "10",
              "title": "10"
            }
          ]
        },
        "current_measure": {
          "type": "string",
          "__example__": "basket"
        },
        "current_qty": {
          "type": "string",
          "__example__": "2"
        },
        "button_label": {
          "type": "string",
          "__example__": "Add to basket"
        },
        "has_video": {
          "type": "boolean",
          "__example__": true
        },
        "has_video_note": {
          "type": "boolean",
          "__example__": false
        },
        "video_note": {
          "type": "string",
          "__example__": "✅ The video is on its way to your chat. Close this form to watch it; your basket is saved."
        },
        "video_link_label": {
          "type": "string",
          "__example__": "🎥 Watch video"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Image",
            "src": "${data.photo}",
            "height": 260,
            "scale-type": "contain",
            "alt-text": "Product photo"
          },
          {
            "type": "TextHeading",
            "text": "${data.name}"
          },
          {
            "type": "TextCaption",
            "text": "${data.note}"
          },
          {
            "type": "RadioButtonsGroup",
            "name": "measure",
            "label": "Measure",
            "required": true,
            "data-source": "${data.measures}",
            "init-value": "${data.current_measure}"
          },
          {
            "type": "Dropdown",
            "name": "qty",
            "label": "How many",
            "required": true,
            "init-value": "${data.current_qty}",
            "data-source": "${data.qty_options}"
          },
          {
            "type": "If",
            "condition": "${data.has_video}",
            "then": [
              {
                "type": "EmbeddedLink",
                "text": "${data.video_link_label}",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "step": "send_video",
                    "sku": "${data.sku}",
                    "category": "${data.category}",
                    "page": "${data.page}",
                    "video": "1"
                  }
                }
              }
            ]
          },
          {
            "type": "If",
            "condition": "${data.has_video_note}",
            "then": [
              {
                "type": "TextBody",
                "text": "${data.video_note}",
                "font-weight": "bold"
              }
            ]
          },
          {
            "type": "EmbeddedLink",
            "text": "Back to list without adding",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "step": "open_category",
                "category": "${data.category}",
                "page": "${data.page}"
              }
            }
          },
          {
            "type": "Footer",
            "label": "${data.button_label}",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "step": "add_line",
                "sku": "${data.sku}",
                "measure": "${form.measure}",
                "qty": "${form.qty}",
                "category": "${data.category}",
                "page": "${data.page}"
              }
            }
          }
        ]
      }
    },
