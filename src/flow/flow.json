{
  "version": "7.3",
  "data_api_version": "3.0",
  "routing_model": {
    "WELCOME": [
      "CATALOGUE",
      "BASKET",
      "SEARCH"
    ],
    "SEARCH": [
      "CATALOGUE",
      "PRODUCT"
    ],
    "CATALOGUE": [
      "PRODUCT",
      "BASKET"
    ],
    "PRODUCT": [
      "BASKET"
    ],
    "BASKET": [
      "CHECKOUT"
    ],
    "CHECKOUT": [
      "ORDER_RECEIVED"
    ],
    "ORDER_RECEIVED": []
  },
  "screens": [
    {
      "id": "WELCOME",
      "title": "${data.shop_name}",
      "data": {
        "shop_name": {
          "type": "string",
          "__example__": "MarketiX Tech"
        },
        "shop_tagline": {
          "type": "string",
          "__example__": "Groceries delivered in Kumasi within 1 hour."
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "main-content": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "metadata": {
                    "type": "string"
                  }
                }
              },
              "start": {
                "type": "object",
                "properties": {
                  "image": {
                    "type": "string"
                  },
                  "alt-text": {
                    "type": "string"
                  }
                }
              },
              "end": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  }
                }
              },
              "badge": {
                "type": "string"
              },
              "on-click-action": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "payload": {
                    "type": "object",
                    "properties": {
                      "step": {
                        "type": "string"
                      },
                      "sku": {
                        "type": "string"
                      },
                      "measure": {
                        "type": "string"
                      },
                      "category": {
                        "type": "string"
                      },
                      "page": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "__example__": [
            {
              "id": "search",
              "main-content": {
                "title": "🔍 Search products",
                "metadata": "Find an item by name"
              },
              "on-click-action": {
                "name": "data_exchange",
                "payload": {
                  "step": "open_search",
                  "sku": "open_search",
                  "measure": "none",
                  "category": "all",
                  "page": "1"
                }
              }
            },
            {
              "id": "reorder_last",
              "main-content": {
                "title": "Repeat my last order",
                "metadata": "Tue 28 Oct · 5 items · GH₵ 95"
              },
              "on-click-action": {
                "name": "data_exchange",
                "payload": {
                  "step": "open_category",
                  "sku": "open_category",
                  "measure": "none",
                  "category": "reorder_last",
                  "page": "1"
                }
              }
            },
            {
              "id": "all",
              "main-content": {
                "title": "All products",
                "metadata": "Everything in stock · 18 products"
              },
              "on-click-action": {
                "name": "data_exchange",
                "payload": {
                  "step": "open_category",
                  "sku": "open_category",
                  "measure": "none",
                  "category": "all",
                  "page": "1"
                }
              }
            },
            {
              "id": "veg_fruits",
              "main-content": {
                "title": "Vegetables & fruits",
                "metadata": "Tomatoes, onions, pepper, plantain"
              },
              "on-click-action": {
                "name": "data_exchange",
                "payload": {
                  "step": "open_category",
                  "sku": "open_category",
                  "measure": "none",
                  "category": "veg_fruits",
                  "page": "1"
                }
              }
            },
            {
              "id": "rice_oil",
              "main-content": {
                "title": "Rice, oil & provisions",
                "metadata": "Rice, oil, sugar, tinned foods"
              },
              "on-click-action": {
                "name": "data_exchange",
                "payload": {
                  "step": "open_category",
                  "sku": "open_category",
                  "measure": "none",
                  "category": "rice_oil",
                  "page": "1"
                }
              }
            },
            {
              "id": "drinks",
              "main-content": {
                "title": "Drinks & water",
                "metadata": "Water, juice, soft drinks"
              },
              "on-click-action": {
                "name": "data_exchange",
                "payload": {
                  "step": "open_category",
                  "sku": "open_category",
                  "measure": "none",
                  "category": "drinks",
                  "page": "1"
                }
              }
            }
          ]
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "NavigationList",
            "name": "categories",
            "label": "What would you like today?",
            "description": "${data.shop_tagline}",
            "list-items": "${data.categories}"
          }
        ]
      }
    },
    {
      "id": "SEARCH",
      "title": "Search",
      "data": {
        "init_query": {
          "type": "string",
          "__example__": "tomatoes"
        },
        "category": {
          "type": "string",
          "__example__": "all"
        },
        "shop_summary": {
          "type": "string",
          "__example__": "Vegetables & fruits · Rice, oil & provisions · Drinks & water"
        },
        "products": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "sku_okra",
              "title": "Okra",
              "description": "from GH₵ 10"
            },
            {
              "id": "sku_onions",
              "title": "Onions",
              "description": "from GH₵ 5"
            },
            {
              "id": "sku_tomatoes",
              "title": "Tomatoes",
              "description": "from GH₵ 10"
            }
          ]
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextInput",
            "name": "query",
            "label": "What do you need?",
            "input-type": "text",
            "required": true,
            "init-value": "${data.init_query}",
            "helper-text": "Type at least 2 letters, e.g. rice, soap, plantain"
          },
          {
            "type": "TextSubheading",
            "text": "We sell"
          },
          {
            "type": "TextBody",
            "text": "${data.shop_summary}"
          },
          {
            "type": "Dropdown",
            "name": "pick",
            "label": "Or pick an item",
            "required": false,
            "data-source": "${data.products}",
            "on-select-action": {
              "name": "data_exchange",
              "payload": {
                "step": "open_product",
                "sku": "${form.pick}",
                "measure": "none",
                "category": "${data.category}",
                "page": "1"
              }
            }
          },
          {
            "type": "Footer",
            "label": "Search",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "step": "search",
                "query": "${form.query}"
              }
            }
          }
        ]
      }
    },
