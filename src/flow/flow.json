    {
      "id": "CHECKOUT",
      "title": "Checkout",
      "data": {
        "cart_id": {
          "type": "string",
          "__example__": "cart_8f3a21"
        },
        "category": {
          "type": "string",
          "__example__": "veg_fruits"
        },
        "has_notice": {
          "type": "boolean",
          "__example__": false
        },
        "notice": {
          "type": "string",
          "__example__": "⚠️ Enter a valid 10-digit MoMo number"
        },
        "order_summary": {
          "type": "string",
          "__example__": "Tomatoes · 2 baskets · GH₵ 240\nOnions · ×1 · GH₵ 5\nDelivery · GH₵ 10\nTotal · GH₵ 255"
        },
        "items_caption": {
          "type": "string",
          "__example__": "2 items"
        },
        "total_caption": {
          "type": "string",
          "__example__": "GH₵ 255"
        },
        "delivery_areas": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "knust",
              "title": "KNUST Campus"
            },
            {
              "id": "ayeduase",
              "title": "Ayeduase"
            },
            {
              "id": "ayigya",
              "title": "Ayigya"
            },
            {
              "id": "bomso",
              "title": "Bomso"
            }
          ]
        },
        "delivery_slots": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "asap",
              "title": "Now · within 1 hour",
              "description": "Rider leaves as soon as your order is packed"
            },
            {
              "id": "today_pm",
              "title": "Today, 5 pm – 7 pm"
            },
            {
              "id": "tomorrow_am",
              "title": "Tomorrow, 7 am – 9 am"
            }
          ]
        },
        "payment_methods": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "momo",
              "title": "Mobile Money (MoMo)",
              "description": "MTN, Telecel or AirtelTigo"
            },
            {
              "id": "cash",
              "title": "Cash on delivery",
              "description": "Pay the rider in cash"
            }
          ]
        },
        "init_full_name": {
          "type": "string",
          "__example__": "Ama Mensah"
        },
        "init_area": {
          "type": "string",
          "__example__": ""
        },
        "init_landmark": {
          "type": "string",
          "__example__": "Unity Hall, Block C"
        },
        "init_phone": {
          "type": "string",
          "__example__": "0244111222"
        },
        "init_slot": {
          "type": "string",
          "__example__": "asap"
        },
        "init_payment": {
          "type": "string",
          "__example__": "momo"
        },
        "init_momo": {
          "type": "string",
          "__example__": "0244111222"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "If",
            "condition": "${data.has_notice}",
            "then": [
              {
                "type": "TextBody",
                "text": "${data.notice}",
                "font-weight": "bold"
              }
            ]
          },
          {
            "type": "TextSubheading",
            "text": "Your order"
          },
          {
            "type": "TextBody",
            "text": "${data.order_summary}"
          },
          {
            "type": "EmbeddedLink",
            "text": "Edit basket",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "step": "open_basket",
                "category": "${data.category}"
              }
            }
          },
          {
            "type": "TextSubheading",
            "text": "1. Where should we deliver?"
          },
          {
            "type": "Dropdown",
            "name": "delivery_area",
            "label": "Select delivery area",
            "required": true,
            "data-source": "${data.delivery_areas}",
            "init-value": "${data.init_area}"
          },
          {
            "type": "TextInput",
            "name": "landmark",
            "label": "Hostel or landmark",
            "input-type": "text",
            "required": true,
            "helper-text": "e.g. Unity Hall, Block C · we'll ask for your map pin next",
            "init-value": "${data.init_landmark}"
          },
          {
            "type": "RadioButtonsGroup",
            "name": "delivery_slot",
            "label": "When",
            "required": true,
            "data-source": "${data.delivery_slots}",
            "init-value": "${data.init_slot}"
          },
          {
            "type": "TextSubheading",
            "text": "2. Who receives it?"
          },
          {
            "type": "TextInput",
            "name": "full_name",
            "label": "Your name",
            "input-type": "text",
            "required": true,
            "init-value": "${data.init_full_name}"
          },
          {
            "type": "TextInput",
            "name": "rider_phone",
            "label": "Phone for the rider",
            "input-type": "phone",
            "required": true,
            "helper-text": "The rider calls this number when they arrive",
            "init-value": "${data.init_phone}"
          },
          {
            "type": "TextSubheading",
            "text": "3. How will you pay?"
          },
          {
            "type": "RadioButtonsGroup",
            "name": "payment",
            "label": "Pay with",
            "required": true,
            "data-source": "${data.payment_methods}",
            "init-value": "${data.init_payment}"
          },
          {
            "type": "If",
            "condition": "${form.payment} == 'momo'",
            "then": [
              {
                "type": "TextInput",
                "name": "momo_number",
                "label": "MoMo number",
                "input-type": "phone",
                "required": true,
                "init-value": "${data.init_momo}",
                "helper-text": "You'll get a prompt on this number to approve the payment"
              }
            ]
          },
          {
            "type": "Footer",
            "label": "Place order",
            "left-caption": "${data.items_caption}",
            "right-caption": "${data.total_caption}",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "step": "place_order",
                "cart_id": "${data.cart_id}",
                "full_name": "${form.full_name}",
                "delivery_area": "${form.delivery_area}",
                "landmark": "${form.landmark}",
                "rider_phone": "${form.rider_phone}",
                "delivery_slot": "${form.delivery_slot}",
                "payment": "${form.payment}",
                "momo_number": "${form.momo_number}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "ORDER_RECEIVED",
      "title": "Order received",
      "terminal": true,
      "data": {
        "order_id": {
          "type": "string",
          "__example__": "MX-1042"
        },
        "order_line": {
          "type": "string",
          "__example__": "Order MX-1042 · GH₵ 250"
        },
        "steps": {
          "type": "string",
          "__example__": "1. 📲 Approve the MoMo prompt on 024 411 1222\n2. 📍 Tap the button below, then share your location pin in the chat\n3. 🛵 Delivery: Now · within 1 hour"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "✅ Order placed"
          },
          {
            "type": "TextSubheading",
            "text": "${data.order_line}"
          },
          {
            "type": "TextBody",
            "text": "What happens next",
            "font-weight": "bold"
          },
          {
            "type": "TextBody",
            "text": "${data.steps}"
          },
          {
            "type": "Footer",
            "label": "Done · share my location",
            "on-click-action": {
              "name": "complete",
              "payload": {
                "order_id": "${data.order_id}"
              }
            }
          }
        ]
      }
    }
  ]
