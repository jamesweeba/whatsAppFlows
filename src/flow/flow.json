    {
      "id": "PRODUCT_SELECT",
      "title": "1 of 4 · Choose items",
      "refresh_on_back": true,
      "data": {
        "categories": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "all",
              "title": "🛒 All Products"
            },
            {
              "id": "vegetables",
              "title": "🥦 Vegetables"
            },
            {
              "id": "grains",
              "title": "🌾 Grains & Staples"
            },
            {
              "id": "spices",
              "title": "🌶️ Spices"
            },
            {
              "id": "snacks",
              "title": "🥜 Snacks"
            }
          ]
        },
        "category_prefill": {
          "type": "string",
          "__example__": "all"
        },
        "pages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "1",
              "title": "Page 1 of 7"
            },
            {
              "id": "2",
              "title": "Page 2 of 7"
            },
            {
              "id": "3",
              "title": "Page 3 of 7"
            }
          ]
        },
        "page_prefill": {
          "type": "string",
          "__example__": "1"
        },
        "products": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "prod-1",
              "title": "🍅 Tomatoes",
              "description": "₵2.00 · Per KG"
            },
            {
              "id": "prod-2",
              "title": "🧅 Onions",
              "description": "₵1.50 · Per KG"
            },
            {
              "id": "prod-3",
              "title": "🌶️ Pepper",
              "description": "₵3.00 · Olonka"
            },
            {
              "id": "prod-4",
              "title": "🥕 Carrots",
              "description": "₵2.50 · Bunch"
            },
            {
              "id": "prod-5",
              "title": "🥬 Cabbage",
              "description": "₵4.00 · Per Piece"
            }
          ]
        },
        "pre_selected": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "__example__": []
        },
        "page_label": {
          "type": "string",
          "__example__": "34 products"
        },
        "selection_note": {
          "type": "string",
          "__example__": "🛒 2 items · ₵7.00 so far"
        },
        "search_prefill": {
          "type": "string",
          "__example__": " "
        },
        "notice": {
          "type": "string",
          "__example__": " "
        },
        "show_notice": {
          "type": "boolean",
          "__example__": false
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "select_form",
            "init-values": {
              "search_query": "${data.search_prefill}",
              "selected_products": "${data.pre_selected}",
              "category_select": "${data.category_prefill}",
              "page_select": "${data.page_prefill}"
            },
            "children": [
              {
                "type": "TextHeading",
                "text": "🛍️ Marketix Groceries"
              },
              {
                "type": "TextCaption",
                "text": "Tick what you need, then tap Continue. Your ticks are kept when you change page."
              },
              {
                "type": "Dropdown",
                "label": "Category",
                "name": "category_select",
                "required": false,
                "data-source": "${data.categories}",
                "on-select-action": {
                  "name": "data_exchange",
                  "payload": {
                    "step": "set_category",
                    "category": "${form.category_select}",
                    "query": "${form.search_query}",
                    "selected_on_page": "${form.selected_products}"
                  }
                }
              },
              {
                "type": "TextInput",
                "label": "Search",
                "name": "search_query",
                "input-type": "text",
                "required": false
              },
              {
                "type": "EmbeddedLink",
                "text": "🔍 Search / Show All",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "step": "search",
                    "query": "${form.search_query}",
                    "category": "${form.category_select}",
                    "selected_on_page": "${form.selected_products}"
                  }
                }
              },
              {
                "type": "TextBody",
                "text": "${data.notice}",
                "visible": "${data.show_notice}"
              },
              {
                "type": "CheckboxGroup",
                "label": "Products",
                "name": "selected_products",
                "required": false,
                "max-selected-items": 10,
                "data-source": "${data.products}"
              },
              {
                "type": "TextCaption",
                "text": "${data.selection_note}"
              },
              {
                "type": "TextCaption",
                "text": "${data.page_label}"
              },
              {
                "type": "Dropdown",
                "label": "Page",
                "name": "page_select",
                "required": false,
                "data-source": "${data.pages}",
                "on-select-action": {
                  "name": "data_exchange",
                  "payload": {
                    "step": "go_page",
                    "page": "${form.page_select}",
                    "query": "${form.search_query}",
                    "category": "${form.category_select}",
                    "selected_on_page": "${form.selected_products}"
                  }
                }
              },
              {
                "type": "Footer",
                "label": "Set quantities ➜",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "step": "continue",
                    "selected_on_page": "${form.selected_products}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
